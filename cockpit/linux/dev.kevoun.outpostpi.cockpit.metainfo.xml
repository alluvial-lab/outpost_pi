<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal AppStream metadata for Linux packaging. Installed in
     share/metainfo/. The <id> matches the app ID and the .desktop file. -->
<component type="desktop-application">
  <id>dev.kevoun.outpostpi.cockpit</id>
  <name>Outpost-Pi Cockpit</name>
  <summary>Multi-pane desktop client for Outpost-Pi</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="dev.kevoun">
    <name>Outpost-Pi</name>
  </developer>

  <description>
    <p>
      Cockpit is the Outpost-Pi desktop client: a multi-pane GUI over the Pi
      engine. It runs agents (each a <code>pi --mode rpc</code>) and terminals
      side by side, with a file tree, per-workspace worktrees, and daemon
      scheduling.
    </p>
  </description>

  <launchable type="desktop-id">dev.kevoun.outpostpi.cockpit.desktop</launchable>

  <url type="homepage">https://kevoun.com</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.1.0" date="2026-06-12">
      <description>
        <p>Interface fully translated to English.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-06-12">
      <description>
        <p>First distributable release of the Cockpit.</p>
      </description>
    </release>
  </releases>
</component>
