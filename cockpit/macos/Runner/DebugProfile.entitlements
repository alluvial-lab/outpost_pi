<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Plan 37 (decision B, local-only desktop dev tool): the Cockpit spawns the
	     `pi` binary and reads user-chosen folders. The macOS sandbox blocks both,
	     so it is OFF in this MVP (not a store app). Revisit if/when distributing
	     via the App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
