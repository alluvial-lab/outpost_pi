{
  "name": "outpost-pi",
  "version": "0.2.1",
  "description": "Mobile remote control and local agent mesh for the Pi coding agent. Pair your phone via QR over a relay, watch tool calls in real time, run multi-Pi sessions over a local Unix Domain Socket broker, and let agents talk to each other through structured request/reply.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "outpost-pi": "dist/index.js",
    "pi-supervisord": "dist/bin/supervisord.js"
  },
  "scripts": {
    "build": "tsc",
    "generate:protocol": "node --import tsx ../tools/protocol-codegen/src/index.ts --target ts --out src/protocol/generated/protocol.generated.ts",
    "check:protocol": "corepack pnpm generate:protocol --check",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm check:protocol && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "remote-control",
    "mobile",
    "coding-agent",
    "agent-mesh",
    "agent-network",
    "uds",
    "broker",
    "qr-pairing",
    "websocket"
  ],
  "pi": {
    "extensions": [
      "./dist"
    ],
    "image": "https://raw.githubusercontent.com/alluvial-lab/outpost_pi/main/branding/banner.png"
  },
  "author": "KevounC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alluvial-lab/outpost_pi.git",
    "directory": "pi-extension"
  },
  "homepage": "https://outpost-pi.kevoun.com",
  "bugs": {
    "url": "https://github.com/alluvial-lab/outpost_pi/issues"
  },
  "files": [
    "dist",
    "skills",
    "service-templates",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "koffi",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/ed25519": "^3.1.0",
    "croner": "^10.0.1",
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.3.13",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}