{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kevoun.com/schemas/outpost-pi.schema.json",
  "title": "Outpost-Pi wire protocol",
  "description": "Umbrella schema for Outpost-Pi protocol families. Family schemas are populated and consumed by generated TS/Dart/Rust code; the manifest registers each family for the generators.",
  "$defs": {
    "uuid": { "$ref": "./defs/common.schema.json#/$defs/uuid" },
    "sessionId": { "$ref": "./defs/common.schema.json#/$defs/sessionId" },
    "turnId": { "$ref": "./defs/common.schema.json#/$defs/turnId" },
    "openJson": { "$ref": "./defs/common.schema.json#/$defs/openJson" }
  },
  "oneOf": [
    { "$ref": "./app-pi-client.schema.json" },
    { "$ref": "./app-pi-server.schema.json" },
    { "$ref": "./relay-control.schema.json" },
    { "$ref": "./cross-pc.schema.json" },
    { "$ref": "./cockpit-control.schema.json" }
  ],
  "x-outpost-pi": {
    "discriminator": "type",
    "profiles": ["compat", "canonical-session"],
    "transports": ["relay-jsonl", "pi-custom-event"],
    "manifest": "./manifest.json",
    "captureUploadFamily": {
      "client": ["capture_upload_begin", "capture_upload_chunk", "capture_upload_end"],
      "server": ["capture_upload_ack", "capture_upload_error"],
      "limitsSource": "./app-pi-client.schema.json#/x-outpost-pi/captureUploadLimits"
    }
  }
}
