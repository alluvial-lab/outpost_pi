{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kevoun.com/schemas/relay-outer.schema.json",
  "title": "Outpost-Pi relay outer envelope",
  "description": "Relay-owned app↔Pi outer envelope. The relay routes peer/room and keeps ct opaque.",
  "$defs": {
    "outerEnvelope": {
      "type": "object",
      "required": ["peer", "room", "ct"],
      "properties": {
        "peer": { "type": "string", "minLength": 1 },
        "room": { "type": "string", "minLength": 1 },
        "ct": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
      },
      "additionalProperties": false,
      "x-outpost-pi": {
        "relayOpaque": ["ct"],
        "profileOptional": {
          "compat": ["room"]
        },
        "maxDecodedBytesDefault": 4194304,
        "maxFrameOverheadBytes": 65536,
        "maxPreAuthFrameBytes": 16384,
        "metadataByteLimits": {
          "deviceId": 128,
          "roomId": 256,
          "roomName": 256,
          "cwd": 4096,
          "sessionId": 512,
          "model": 256,
          "thinking": 32
        }
      }
    }
  },
  "$ref": "#/$defs/outerEnvelope"
}
