# cmux / claude
.fresh/
.*
# but DO track CI workflows and the local work queue (the `.*` rule above would otherwise ignore dot dirs)
!.github/
!.work/
!.work/**
!.agents/
!.agents/**
!.research/
!.research/**

# orchestration: results are ephemeral (per-task execution logs);
# INSTRUCTIONS.md and contracts/ are versioned (shared contract).
.orchestration/results/*
!.orchestration/results/.gitkeep

# Node
node_modules/
dist/
*.tsbuildinfo

# Rust
target/

# NextJS
.next/
out/
.vercel/

# Flutter / Dart
dockercache/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.packages
.pub-cache/
.pub/

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
ios/Runner/GeneratedPluginRegistrant.*
ios/Flutter/ephemeral/

# Android
android/.gradle/
android/local.properties
android/app/release/
android/.kotlin/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# Editor
.vscode/
.idea/
*.iml
*.swp
.DS_Store

# Env / secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ring-log / debug exports — transient binary exports from the app's DebugLog
# (reconnect repros, capture-routing probes). Cited by work items by filename
# but never committed; reproduce by re-running the instrumented scenario.
debug/

# pnpm approve-builds state (allowBuilds: esbuild) — machine-local pnpm
# config written when pnpm prompts to approve native build scripts. Not repo
# content; regenerated per-machine.
pnpm-workspace.yaml

# Test artifacts — pi-extension model-persist test writes a real settings.json
pi-extension/test/.pi/

# Per-cwd outpost-pi runtime config (agent_name, auto_start_relay) — machine-local
# state written by `outpost-pi claude` / the wizard, never repo content. Matches
# any `.pi/` dir at any depth (root, pi-extension/, subprojects).
.pi/

# Local key material / secrets — never commit (AGENTS.md: never commit
# key material, local .pi/, pairing state, or secrets)
*.key
*.pem

# Throwaway spike / verification scripts — not durable repo content. Cited by
# work items by filename; reproduce by re-running. (e.g.
# pi-extension/spike-session-before-switch.mjs for
# story-fix-stale-ctx-messageapi-rearm-on-reload.)
**/spike-*.mjs
